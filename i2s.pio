;i2s BCLK64fs MCLK256fs
.program i2s_mclk
set pins, 0
set pins, 1



;i2s BCLK64fs MCLK NO
.program i2s_data
.side_set 2
;                      /--BCLK
;                      |/-LRCLK
;                      ||
pull block      side 0b10

out pins, 1     side 0b00
set x, 29       side 0b10

L1:
out pins, 1     side 0b00
jmp x--, L1     side 0b10

out pins, 1     side 0b01
pull block      side 0b11

out pins, 1     side 0b01
set x, 29       side 0b11

L2:
out pins, 1     side 0b01
jmp x--, L2     side 0b11

out pins, 1     side 0b00


;lsbj16
.program i2s_pt8211
.side_set 2
;                      /--BCK
;                      |/-WS
;                      ||
pull block      side 0b10 [1]

out pins, 1     side 0b01 [1]
set x, 13       side 0b11 [1]

L1:
out pins, 1     side 0b01 [1]
jmp x--, L1     side 0b11 [1]

out pins, 1     side 0b01 [1]
pull block      side 0b11 [1]

out pins, 1     side 0b00 [1]
set x, 13       side 0b10 [1]

L2:
out pins, 1     side 0b00 [1]
jmp x--, L2     side 0b10 [1]

out pins, 1     side 0b00 [1]


;i2s BCLK32fs AK449X EXDF
.program i2s_exdf_a
.side_set 3
;                      /---MCLK
;                      |/--BCK
;                      ||/-WCK
;                      |||
pull block      side 0b111 [1]

out pins, 1     side 0b000 [1]
set x, 13       side 0b110 [1]

L1:
out pins, 1     side 0b000 [1]
jmp x--, L1     side 0b110 [1]

out pins, 1     side 0b000 [1]
nop             side 0b110 [1]

out pins, 1     side 0b001 [1]
set x, 13       side 0b111 [1]

L2:
out pins, 1     side 0b001 [1]
jmp x--, L2     side 0b111 [1]

out pins, 1     side 0b001 [1]


;i2s BCLK32fs AK449X EXDF
.program i2s_exdf_b

pull block      [1]

out pins, 1     [1]
set x, 13       [1]

L1:
out pins, 1     [1]
jmp x--, L1     [1]

out pins, 1     [1]
nop             [1]

out pins, 1     [1]
set x, 13       [1]

L2:
out pins, 1     [1]
jmp x--, L2     [1]

out pins, 1     [1]


;i2s BCLK64fs NO MCLK DUAL
.program i2s_data_dual

pull block

out pins, 1
set x, 29

L1:
out pins, 1
jmp x--, L1

out pins, 1
pull block

out pins, 1
set x, 29

L2:
out pins, 1
jmp x--, L2

out pins, 1



;lsbj16_dual
.program i2s_pt8211_dual
;                      /--BCK
;                      |/-WS
;                      ||
pull block      [1]

out pins, 1     [1]
set x, 13       [1]

L1:
out pins, 1     [1]
jmp x--, L1     [1]

out pins, 1     [1]
pull block      [1]

out pins, 1     [1]
set x, 13       [1]

L2:
out pins, 1     [1]
jmp x--, L2     [1]

out pins, 1     [1]


;i2s_input BCLK64fs NO MCLK
.program i2s_input
.side_set 2

; bit 1: LRCK, bit 0: BCLK
; BCLK=11, LRCK=12 -> clock_pin_base=11

    set x, 30           side 0b01 ; dummy bclk
L1:
    nop                 side 0b00 [1]
    in pins, 1          side 0b01 [1]
    jmp x--, L1         side 0b01

    set x, 30           side 0b11 ; dummy bclk
L2:
    nop                 side 0b10 [1]
    in pins, 1          side 0b11 [1]
    jmp x--, L2         side 0b11

;i2s_slave_input
.program i2s_slave_input
; pin 0: DATA, pin 1: BCLK, pin 2: LRCK

public entry_point:
    wait 0 pin 2        ; Wait LRCK Low (Channel Left)
    wait 1 pin 1        ; Wait BCLK Rising Edge (bit dummy/delay)
    set x, 31
l_loop:
    wait 0 pin 1        ; Wait BCLK Falling
    wait 1 pin 1        ; Wait BCLK Rising
    in pins, 1          ; Take 1 bit data (pin 0 / DATA)
    jmp x--, l_loop

    wait 1 pin 2        ; Wait LRCK High (Channel Right)
    wait 1 pin 1        ; Wait BCLK Rising Edge (bit dummy/delay)
    set x, 31
r_loop:
    wait 0 pin 1        ; Wait BCLK Falling
    wait 1 pin 1        ; Wait BCLK Rising
    in pins, 1          ; Take 1 bit data (pin 0 / DATA)
    jmp x--, r_loop
    jmp entry_point

;i2s_slave
.program i2s_slave
;in pin 0   LRCLK
;in pin 1   BCLK
;r LSB
    wait 0 pin 0
    out pins 1
    wait 1 pin 1
    pull block

;l MSB
    wait 1 pin 1
    out pins 1
    wait 0 pin 1
    set y 29

;l nbit
L_LOOP:
    wait 1 pin 1
    out pins 1
    wait 0 pin 1
    jmp y-- L_LOOP

;l LSB
    wait 1 pin 0
    out pins 1
    wait 0 pin 1
    pull block

;r MSB
    wait 1 pin 1
    out pins 1
    wait 0 pin 1
    set y 29

;r nbit
R_LOOP:
    wait 1 pin 1
    out pins 1
    wait 0 pin 1
    jmp y-- R_LOOP
